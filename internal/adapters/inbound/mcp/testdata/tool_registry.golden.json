                  "altText",
                  "role"
                ],
                "type": [
                  "null",
                  "object"
                ]
              },
              "purchasable": {
                "type": "boolean"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "catalogItemId",
              "title",
              "inStock",
              "purchasable"
            ],
            "type": "object"
          },
          "type": [
            "null",
